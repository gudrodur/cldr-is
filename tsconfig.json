{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],

    // Nothing is emitted. This repo is read and copied, not installed, so tsc
    // is only the type check. See README.md.
    "noEmit": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": ["src", "test"]
}
